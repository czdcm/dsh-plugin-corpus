{
  "name": "dsh-plugin-corpus",
  "version": "1.3.0",
  "description": "全局语料库：内容放在一个可整体搬走的根目录，插件按工作区/会话/路径授权，提供检索、按行读取、文档导入、内置小代理结构化、仓库/会话总结接口、后台重建、Web GUI 面板与右栏权限管理。",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "files": [
    "lib",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czdcm/dsh-plugin-corpus.git"
  },
  "homepage": "https://github.com/czdcm/dsh-plugin-corpus",
  "bugs": {
    "url": "https://github.com/czdcm/dsh-plugin-corpus/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "knowledge-base",
    "local-knowledge-base",
    "personal-knowledge-base",
    "knowledge-management",
    "document-search",
    "file-search",
    "full-text-search",
    "document-retrieval",
    "knowledge-retrieval",
    "document-index",
    "document-import",
    "document-parser",
    "reference-library",
    "research",
    "pdf",
    "pdf-extraction",
    "docx",
    "pptx",
    "xlsx",
    "office",
    "ocr",
    "markdown",
    "text-extraction",
    "rag",
    "ai-context",
    "llm-context",
    "知识库",
    "本地知识库",
    "文档检索",
    "文件搜索",
    "全文检索",
    "资料库",
    "文档导入",
    "文档解析"
  ]
}
